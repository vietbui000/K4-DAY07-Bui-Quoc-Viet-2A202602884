# Embedding provider selection for manual experiments
# EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai
# EMBEDDING_PROVIDER=gemini

# Optional: set cache directories for the local multilingual embedder
# HF_HOME=./.hf-cache
# SENTENCE_TRANSFORMERS_HOME=./.sentence-transformers

# Optional: OpenAI embedding configuration
# OPENAI_API_KEY=your-key-here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Gemini embedding configuration (free tier at aistudio.google.com)
# GEMINI_API_KEY=your-key-here
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# bench.py: real Gemini embedding + LLM (no mock fallback)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_LLM_MODEL=gemini-3.8-flash

# Groq generation + local multilingual embeddings (bench.py)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-groq-key
# GROQ_LLM_MODEL=openai/gpt-oss-20b
# LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional: for ChromaDB persistence (bonus task)
# CHROMA_PERSIST_DIR=./chroma_data
